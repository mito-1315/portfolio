# Copy this file to .env (next to docker-compose.yml) and fill it in. Never commit .env.

# The database password. Anything long and random.
POSTGRES_PASSWORD=

# Admin sign-in. ADMIN_TOKEN_SECRET should be a long random string (32+ characters).
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
IP_HASH_SALT=

# The address of your website, exactly as people type it (no trailing slash).
CLIENT_ORIGIN=https://example.com

# Port the website is served on, on the server.
WEB_PORT=80

# Google sign-in for the admin (recommended). When both are set the password login is
# switched off, unless ALLOW_PASSWORD_LOGIN=1.
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=
ALLOW_PASSWORD_LOGIN=

# Optional: song lookup in the admin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: a search service for "Find notes online" in the admin (Guess the Song).
# Without one, DuckDuckGo's results page is read, which it may refuse to serve to automated readers.
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

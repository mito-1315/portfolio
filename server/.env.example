# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/portfolio?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Admin sign-in. Use a long random value for ADMIN_TOKEN_SECRET.
ADMIN_PASSWORD="change-me"
ADMIN_TOKEN_SECRET="change-me-to-a-long-random-string"

# Used to hash visitor IPs for spam control.
IP_HASH_SALT="change-me-too"

# Optional: lets the admin look up song details on Spotify (title, artist, artwork).
# Create an app at https://developer.spotify.com/dashboard and paste its Client ID and Secret.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Optional: Google sign-in for the admin page (recommended). Create an OAuth "Web application"
# client at https://console.cloud.google.com/apis/credentials, add your site as an authorised
# JavaScript origin (http://localhost:5173 while developing), then fill these in.
# When both are set, the password login is switched off unless ALLOW_PASSWORD_LOGIN="1".
GOOGLE_CLIENT_ID=""
ADMIN_GOOGLE_EMAILS=""
ALLOW_PASSWORD_LOGIN=""

# Optional: lets "Find notes online" in the admin use a search service instead of reading
# DuckDuckGo's results page. Brave Search API or Google Programmable Search; either works.
BRAVE_SEARCH_API_KEY=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_ID=""

# Guess the Song is built but switched off. Set to "1" (and VITE_GUESS_THE_SONG=1 for the site) to turn it on.
GUESS_THE_SONG=""

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://portfolio-690b8d61fc66.herokuapp.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://portfolio-690b8d61fc66.herokuapp.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/|assets/).*)", "destination": "/index.html" }
  ]
}
